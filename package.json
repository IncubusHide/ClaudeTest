{
  "name": "wardrobe-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo hosting personal desktop applications",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@apps/wardrobe",
    "build": "npm run build --workspace=@apps/wardrobe",
    "dist:win": "npm run dist:win --workspace=@apps/wardrobe",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
